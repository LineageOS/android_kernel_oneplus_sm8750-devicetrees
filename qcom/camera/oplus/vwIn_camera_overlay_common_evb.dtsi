	config {
		pins = "gpio15";
		bias-pull-down; /* PULL DOWN */
		drive-strength = <2>; /* 2 MA */
		output-low;
		qcom,remote;
	};
};

&cci_i2c_sda0_active {
	mux {
		/* CLK, DATA */
		pins = "gpio70";
		function = "cci_i2c_sda0";
	};

	config {
		pins = "gpio70";
		bias-disable; /* No PULL */
		drive-strength = <2>; /* 2 MA */
		//qcom,i2c_pull;
	};
};

&cci_i2c_scl0_active {
	mux {
		/* CLK, DATA */
		pins = "gpio71";
		function = "cci_i2c_scl0";
	};

	config {
		pins = "gpio71";
		bias-disable; /* No PULL */
		drive-strength = <2>; /* 2 MA */
		//qcom,i2c_pull;
	};
};

